{
  "name": "@rare/launcher",
  "version": "0.2.0",
  "productName": "rareteam",
  "description": "Единый игровой лаунчер rareteam",
  "author": "rareteam",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build && electron-builder",
    "test": "vitest run electron/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@rare/contracts": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "ru.rareteam.launcher",
    "productName": "rareteam",
    "executableName": "rareteam",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/electron/main.js",
      "dist-electron/electron/preload.cjs",
      "dist-electron/electron/launch.js",
      "dist-electron/electron/runtime.js",
      "dist-electron/electron/sync.js",
      "dist-electron/electron/updater.js",
      "dist-electron/electron/source.js"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://launcher-api.rarenetwork.ru/artifacts/launcher"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/logo.ico",
      "extraResources": [
        {
          "from": "css-pack",
          "to": "css-pack"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "rareteam-${version}-Windows-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "rareteam-${version}-Windows-Portable-${arch}.${ext}"
    },
    "mac": {
      "target": "zip",
      "icon": "src/assets/logo.png",
      "artifactName": "rareteam-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "src/assets/logo.png",
      "artifactName": "rareteam-${version}-Linux-${arch}.${ext}"
    }
  }
}
